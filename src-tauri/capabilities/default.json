{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:3939/*", "http://localhost:3939/*"]
  },
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "server",
          "sidecar": true
        }
      ]
    }
  ]
}
