{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VaLight Tracker",
  "version": "2.0.0",
  "identifier": "com.aebisc.valoranttracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VaLight Tracker",
        "url": "index.html",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "focusable": true,
        "center": true
      }


    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0QjQ3NzY0ODU4RDYzRkUKUldUK1k0MkZaSGUwbEdzZExaU0wvRjNLOU9uejFJdysyL0V5TlhYbndoY3VZTUtoZDYvWnk1dGEK",
      "endpoints": [
        "https://github.com/Aebisc/Valight-Tracker/releases/latest/download/latest.json"
      ]
    }
  }
}
