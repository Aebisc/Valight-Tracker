{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VaLight Tracker",
  "version": "1.1.0",
  "identifier": "com.aebisc.valoranttracker",
  "build": {
    "frontendDist": "dist-placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/server"],
    "resources": ["resources/server/**/*"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0QjQ3NzY0ODU4RDYzRkUKUldUK1k0MkZaSGUwbEdzZExaU0wvRjNLOU9uejFJdysyL0V5TlhYbndoY3VZTUtoZDYvWnk1dGEK",
      "endpoints": [
        "https://github.com/Aebisc/Valight-Tracker/releases/latest/download/latest.json"
      ]
    }
  }
}
